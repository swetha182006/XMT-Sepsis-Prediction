# ==============================================================================
# XMT-Sepsis-System — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and replace placeholder values with your credentials.
# NEVER commit the real .env file or real secrets to Git version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ThingSpeak IoT Hardware Telemetry (ESP32 + MAX30102)
# ------------------------------------------------------------------------------
THINGSPEAK_CHANNEL_ID=3490289
THINGSPEAK_API_KEY=your_thingspeak_write_api_key_here
THINGSPEAK_READ_API_KEY=your_thingspeak_read_api_key_here

# ------------------------------------------------------------------------------
# 2. Supabase Integration (Opt-In Cloud Database & Storage)
# ------------------------------------------------------------------------------
# Master toggle: set to 'true' to enable Supabase cloud database queries.
# Defaults to 'false' (system runs 100% offline on local CSV/Parquet files).
USE_SUPABASE_DB=false

# Automatic fallback to local storage if cloud is unreachable or encounters an error.
FALLBACK_TO_LOCAL_STORAGE=true

# Supabase Project Base URL (e.g. https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Backend Server Service Role Key (NEVER expose to frontend or client payloads)
SUPABASE_SERVICE_ROLE_KEY=your_backend_service_role_secret_key_here

# Optional Client Anon Public Key (if direct postgREST reads are enabled)
SUPABASE_ANON_KEY=your_client_anon_key_here

# Private Supabase Storage Bucket for Chest X-Ray DICOM/JPEG studies
SUPABASE_CXR_BUCKET=chest-xrays
SUPABASE_STORAGE_URL_EXPIRES_IN=300

# ------------------------------------------------------------------------------
# 3. Application Security & Authentication
# ------------------------------------------------------------------------------
# Require authentication on Flask API routes (default: true)
REQUIRE_AUTH=true
